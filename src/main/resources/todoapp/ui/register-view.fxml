<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.example.todoapp.controller.RegisterController"
        alignment="CENTER"
        spacing="15"
        styleClass="auth-page"
        stylesheets="@../styles/dashboard.css">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label
            text="Create Account"
            styleClass="auth-title"/>

    <Label
            text="Start using Todo App"
            styleClass="auth-subtitle"/>

    <VBox spacing="6" styleClass="form-container">

        <Label text="Email" styleClass="field-label"/>

        <TextField
                fx:id="emailField"
                promptText="Enter your email"
                styleClass="form-field"/>

        <Label text="Password" styleClass="field-label"/>

        <PasswordField
                fx:id="passwordField"
                promptText="Create a password"
                styleClass="form-field"/>

        <Label text="Repeat Password" styleClass="field-label"/>

        <PasswordField
                fx:id="repeatPasswordField"
                promptText="Repeat your password"
                styleClass="form-field"/>

        <Label
                fx:id="messageLabel"
                styleClass="message-label"
                wrapText="true"/>

        <Button
                fx:id="registerButton"
                text="Register"
                onAction="#handleRegister"
                styleClass="primary-button"/>

    </VBox>

    <VBox alignment="CENTER" spacing="5">

        <Label text="Already have an account?"/>

        <Hyperlink
                text="Login"
                onAction="#handleLogin"
                styleClass="auth-link"/>

    </VBox>

</VBox>