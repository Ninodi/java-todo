<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.layout.VBox?>
<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.example.todoapp.controller.DashboardController"
        stylesheets="@../styles/dashboard.css"
        styleClass="dashboard">

    <!-- HEADER -->
    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="header">

            <Label
                    text="Welcome Back!"
                    styleClass="app-title"/>

            <HBox
                    alignment="CENTER_RIGHT"
                    HBox.hgrow="ALWAYS">

                <Button
                        styleClass="logout-btn"
                        text="Log Out"
                        onAction="#handleLogout"/>

            </HBox>

        </HBox>
    </top>


    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea"/>
    </center>


    <!-- BOTTOM NAVIGATION -->
    <bottom>
        <HBox
                alignment="CENTER"
                spacing="40"
                styleClass="bottom-navigation">

            <!-- TODOS -->
            <Button
                    fx:id="todosButton"
                    onAction="#showTodos"
                    styleClass="nav-btn">

                <graphic>
                    <FontIcon
                            iconLiteral="fas-tasks"
                            styleClass="nav-icon"/>
                </graphic>

            </Button>


            <!-- CATEGORIES -->
            <Button
                    fx:id="categoriesButton"
                    onAction="#showCategories"
                    styleClass="nav-btn">

                <graphic>
                    <FontIcon
                            iconLiteral="fas-folder"
                            styleClass="nav-icon"/>
                </graphic>

            </Button>

            <Button
                    fx:id="addTodoButton"
                    onAction="#showAddTodoView"
                    styleClass="add-todo-btn">

                <graphic>
                    <FontIcon
                            iconLiteral="fas-plus"
                            styleClass="add-icon"/>
                </graphic>

            </Button>


            <!-- PROFILE -->
            <Button
                    fx:id="statsButton"
                    onAction="#showProfile"
                    styleClass="nav-btn">

                <graphic>
                    <FontIcon
                            iconLiteral="fas-chart-pie"
                            styleClass="nav-icon"/>
                </graphic>

            </Button>
            <!-- PROFILE -->
            <Button
                    fx:id="profileButton"
                    onAction="#showProfile"
                    styleClass="nav-btn">

                <graphic>
                    <FontIcon
                            iconLiteral="fas-user"
                            styleClass="nav-icon"/>
                </graphic>

            </Button>

        </HBox>
    </bottom>

</BorderPane>