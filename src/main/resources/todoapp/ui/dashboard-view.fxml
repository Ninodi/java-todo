<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.example.todoapp.controller.DashboardController"
        stylesheets="@../styles/dashboard.css"
        styleClass="dashboard">

    <!-- HEADER -->
    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="20"
                styleClass="header">

            <Label
                    text="Todo App"
                    styleClass="app-title"/>

            <HBox
                    alignment="CENTER_RIGHT"
                    HBox.hgrow="ALWAYS">

                <Button
                        text="Logout"
                        onAction="#handleLogout"/>

            </HBox>

        </HBox>
    </top>


    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea"/>
    </center>


    <!-- BOTTOM NAVIGATION -->
    <bottom>
        <HBox
                alignment="CENTER"
                spacing="40"
                styleClass="bottom-navigation">

            <Button onAction="#showTodos">
                <graphic>
                    <FontIcon iconLiteral="fas-tasks"/>
                </graphic>
            </Button>

            <Button onAction="#showCategories">
                <graphic>
                    <FontIcon iconLiteral="fas-folder"/>
                </graphic>
            </Button>

            <Button onAction="#showProfile">
                <graphic>
                    <FontIcon iconLiteral="fas-user"/>
                </graphic>
            </Button>

        </HBox>
    </bottom>

</BorderPane>